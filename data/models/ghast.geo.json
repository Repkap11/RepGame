            "description": {
                "identifier": "geometry.ghast",
                "texture_width": 64,
                "texture_height": 32
            },
            // Repo-authored port of the Bedrock ghast: that geo is written
            // at 4.5 pixels per texel with per-face UVs, which box-UV
            // import can't express — everything here is the same model
            // divided by 4.5, so 1 model pixel == 1 skin texel and each
            // cube's box-uv corner lands at [0, 0] (the authored per-face
            // layout already matched the box strip there; only the
            // v-flipped down faces differ, invisible under the body).
            // MobTypeDef::model_scale = 4.5 renders it back at full size.
            // Each tentacle's -23° rest splay tips it backward (+Z; the
            // model's -Z is its front) so they drag behind the flight
            // direction; the sway rides MOB_ANIM_GHAST_TENTACLES.
            "bones": [
