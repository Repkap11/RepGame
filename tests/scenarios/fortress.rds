#! terrain
#! timeout 300
# Nether fortress generation: deterministic structure at grid cell (-1,0)
# — anchor (-187,67), deck y -5876 (anchor selection favours the lowest
# cavern floor in the cell, i.e. open cavern / lava basins). Asserts
# through the real chunk-load path: keep floor/interior carve, generated
# CHEST slots (lower hall + upper room) and the inert MOB_SPAWNER the
# upper room carries. Loot contents are covered by test_fortress;
# positions verified via rep-dbg inspect.
wait_idle 20 6000
debug 0
imgui 0
fly on
rd 6
goto -186.5 -5867 67.5
wait 120
wait_idle 10 6000
chatopen /
type dimension
wait 2
signkey enter
wait 2
assert_chat Dimension: nether
# Keep: floor brick under the anchor, carved hall interior above it.
assert_block -187 -5876 67 NETHER_BRICK
assert_block -187 -5875 67 AIR
# Lower-hall chest, upper-room chest + its inert spawner.
assert_block -203 -5875 56 CHEST
assert_block -171 -5869 76 CHEST
assert_block -173 -5869 59 MOB_SPAWNER
camera -186.5 -5870 67.5 45 -5
screenshot fortress_keep
echo fortress done
