#! terrain
#! timeout 300
# Nether fortress generation: deterministic structure at grid cell (1,-1)
# — anchor (432,-140), deck y -5854, over a lava basin (anchor selection
# scores candidates by open floor-to-roof air and never places a deck
# below the floor; decks roll a narrow band ~ly 94-109 ≈ world -5850, so
# complexes perch at mid-cavern height rather than hugging the sea).
# Asserts through the real chunk-load path: keep floor/interior carve,
# generated CHEST slots (lower hall + upper room) and the inert
# MOB_SPAWNER the upper room carries. Loot contents are covered by
# test_fortress; positions verified via the layout dump.
wait_idle 20 6000
debug 0
imgui 0
fly on
rd 6
goto 432.5 -5845 -139.5
wait 120
wait_idle 10 6000
chatopen /
type pos
wait 2
signkey enter
wait 2
assert_chat - nether
# Keep: floor brick under the anchor, carved hall interior above it.
assert_block 432 -5854 -140 NETHER_BRICK
assert_block 432 -5853 -140 AIR
# Lower-hall chest, upper-room chest + its inert spawner.
assert_block 420 -5853 -149 CHEST
assert_block 444 -5847 -133 CHEST
assert_block 442 -5847 -146 MOB_SPAWNER
camera 432.5 -5852 -139.5 45 -5
screenshot fortress_keep
echo fortress done
