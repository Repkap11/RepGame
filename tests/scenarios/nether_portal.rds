#! terrain
#! timeout 300
# Nether portal travel: a hand-staged obsidian ring filled with PORTAL
# cells (frame detection/ignition is covered by test_dimension; setblock
# writes the lit cells directly). Standing in the plate for
# PORTAL_TRAVEL_TICKS (80) trips repgame_portal_tick's dwell counter and
# drops the player on generated nether ground; portal_pending_tick then
# finds or builds the destination portal once the torus catches up.
# Linking applies the 8:1 scale: the source frame's interior centre maps
# to the destination anchor by /8 when nether-bound and *8 when
# overworld-bound, and the existing-portal search and the build site
# centre on that anchor (portal_scale_coord). /pos reports the band in
# its dimension field, so assert_chat verifies each hop.
wait_idle 20 6000
debug 0
imgui 0

# Baseline: the flat test world starts in the overworld band.
chatopen /
type pos
wait 2
signkey enter
wait 2
assert_chat - overworld

# Stage a lit 4x5 portal: obsidian ring at x 20..23, y 70..74, z 30;
# `ignite` runs the real portal_ignite path — it validates the ring and
# fills the interior (x 21..22, y 71..73) with PORTAL cells.
fill 20 70 30 23 74 30 OBSIDIAN
wait 5
# Placement only writes replaceable cells, so the interior must be
# re-opened to AIR before ignition.
fill 21 71 30 22 73 30 AIR
wait 5
ignite 21 71 30
wait 5
assert_block 21 72 30 PORTAL
assert_block 20 72 30 OBSIDIAN

# Stand inside the plate. Gravity settles feet on the bottom frame row;
# feet and body cells both land on PORTAL cells. The source centre
# (21,72,30) maps to the nether anchor (2,3): the destination frame is
# materialized by mapgen there (ring x 20..23, y -5825..-5821, z -20 —
# a basalt shelf), and arrival stands the player inside the new plate.
goto 21.5 73 30.5
wait 120
wait_idle 10 6000
chatopen /
type pos
wait 2
signkey enter
wait 2
assert_chat - nether
assert_pos 22.0 -5822.4 -19.5 2
assert_block 21 -5824 -20 PORTAL
screenshot nether_portal

# Pop up through the frame top: crossing the lintel's obsidian/AIR band
# releases must_exit, then the player settles back inside the plate and
# the dwell re-trips. The nether frame's centre (21,-5823,-20) maps to the
# overworld anchor (168,-160) — outside the original portal's search box,
# so a SECOND overworld frame is built there and we land inside it.
goto 21.5 -5819.4 -19.5
wait 240
wait_idle 10 6000
chatopen /
type pos
wait 2
signkey enter
wait 2
assert_chat - overworld
# The built frame: ring x 167..170, y -10..-6, z -160, interior
# x 168..169, y -9..-7 — ~1 block off the scaled anchor.
assert_pos 169.0 -7.4 -159.5 2
assert_block 168 -9 -160 PORTAL
assert_block 167 -10 -160 OBSIDIAN

# Third leg: back into the ORIGINAL overworld portal — the nether anchor
# (2,3) has the leg-1 frame (at x 20..23, z -20, ~29 blocks off the
# anchor) inside its search box, so that same nether portal is reused:
# no new frame.
goto 24.5 73 30.5
wait 15
goto 21.5 73 30.5
wait 240
wait_idle 10 6000
chatopen /
type pos
wait 2
signkey enter
wait 2
assert_chat - nether
# Reuses the same nether portal built on the first hop.
assert_pos 22.0 -5822.4 -19.5 2
assert_block 21 -5824 -20 PORTAL

# Fourth leg: a nether portal far off the scaled anchor (x ~200 ->
# overworld anchor x ~1600) — the destination search misses and the frame
# is BUILT on loaded overworld terrain. The site scan must skip
# rows outside the loaded window, so the frame lands on the real surface,
# not the WATER_LEVEL+2 ledge embedded in rock.
rd 2
goto 200.5 -5904 40.5
wait 300
wait_idle 10 6000
# Placement only writes replaceable cells — clear the solid netherrack
# volume to AIR before staging the ring.
fill 198 -5907 31 203 -5899 33 AIR
wait 5
fill 199 -5905 32 202 -5901 32 OBSIDIAN
wait 5
fill 200 -5904 32 201 -5902 32 AIR
wait 5
ignite 200 -5904 32
wait 5
assert_block 200 -5903 32 PORTAL
# Drop straight onto the sill — an eye-height goto would let the fall
# tunnel through the 1-block row into the cleared pocket below.
goto 200.5 -5902 32.5
wait 240
wait_idle 10 6000
# The new overworld frame sits on the terrain surface right at the scaled
# anchor: ring x 1599..1602, y 9..13, z 256, interior x 1600..1601,
# y 10..12 — sill obsidian on the grass, portal interior above it, not the
# y2 ledge and not buried.
assert_pos 1601.0 11.6 256.5 2
assert_block 1600 11 256 PORTAL
assert_block 1599 9 256 OBSIDIAN
chatopen /
type pos
wait 2
signkey enter
wait 2
assert_chat - overworld

# Return through the command path — already in the overworld, so
# /overworld is a no-op error.
chatopen /
type overworld
wait 2
signkey enter
wait 60
assert_chat Already in the overworld

# Breaking a frame block pops the adjacent PORTAL cell via the
# survive rule, cascading the interior clear. goto first so the original
# portal's chunks are back inside the torus.
# Stand beside the frame — inside the plate would just travel again.
goto 24.5 73 30.5
wait_idle 10 6000
setblock 20 72 30 AIR
wait 10
assert_block 21 72 30 AIR
assert_block 22 72 30 AIR

echo nether_portal done
